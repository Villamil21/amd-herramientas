{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMD Herramientas",
  "version": "../package.json",
  "identifier": "co.amdsoluciones.herramientas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AMD Módulos",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F2F3F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "public.app-category.business",
    "copyright": "AMD Soluciones Integrales S.A.S.",
    "shortDescription": "Herramientas administrativas y contables",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNTQxNjVCMThDQjFGRDMKUldUVEg4c1lXeFpVd25iNXFLejJCV0w3SncwOFd6aU5na3laTC9aMjQ0dDJScWNUOThjKzdtYU4K",
      "endpoints": [
        "https://github.com/Villamil21/amd-herramientas/releases/latest/download/latest.json"
      ]
    }
  }
}
